<?xml version="1.0" encoding="UTF-8"?>

<faces-config xmlns="http://java.sun.com/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
              http://java.sun.com/xml/ns/javaee/web-facesconfig_2_1.xsd"
              version="2.1">

    <application>
        <!-- Configuración de localización -->
        <locale-config>
            <default-locale>es_PE</default-locale>
            <supported-locale>es</supported-locale>
        </locale-config>

        <!-- Resolución de EL con Spring -->
        <el-resolver>org.springframework.web.jsf.el.SpringBeanFacesELResolver</el-resolver>

        <!-- Registro del Resource Bundle -->
        <resource-bundle>
            <base-name>cadenas.validaciones</base-name>
            <var>valMsg</var>
        </resource-bundle>

        <!-- Registro del SystemEventListener para CSRF Token -->
        <system-event-listener>
            <system-event-listener-class>pe.bn.com.sate.ope.transversal.util.CsrfTokenPreRenderViewListener</system-event-listener-class>
            <system-event-class>javax.faces.event.PreRenderViewEvent</system-event-class>
        </system-event-listener>
    </application>

    <lifecycle>
        <phase-listener id="nocache">pe.bn.com.sate.ope.transversal.util.vista.CacheControlPhaseListener</phase-listener>
         <phase-listener>pe.bn.com.sate.ope.application.view.LoginController</phase-listener>
    </lifecycle>

</faces-config>
